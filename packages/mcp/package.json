{
  "name": "@claude-organizer/mcp",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "bin": {
    "claude-organizer-mcp": "./dist/server.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@claude-organizer/core": "workspace:*",
    "@claude-organizer/db": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
